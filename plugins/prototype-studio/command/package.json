  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuxiang951023/deepseek-harness.git",
    "directory": "plugins/prototype-studio/command"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-commands": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-commands": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-alpha.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsc && tsdown",
    "prepare": "pnpm install --ignore-scripts && pnpm build"
  }
