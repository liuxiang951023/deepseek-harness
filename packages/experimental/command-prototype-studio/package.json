{
  "name": "@deepseek-ai/dsh-command-prototype-studio",
  "description": "Slash command that turns a conversation request with PRD and screenshot attachments into a prototype task",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/command-prototype-studio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
